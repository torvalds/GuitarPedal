			(justify left top)
		)
		(uuid "152908c3-9b81-4df0-9298-2dfd01990773")
	)
	(text_box "RP2354 GPIO assignments\n\nI2C0 for on-board EEPROM\nI2C1 for off-board QWIIC connector (display)\n\nGPIO20/21 function 2 is UART1 TX / RX for MIDI\n"
		(exclude_from_sim no)
		(at 13.97 82.55 0)
		(size 67.31 113.665)
		(margins 0.9525 0.9525 0.9525 0.9525)
